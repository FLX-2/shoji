{
  "name": "shoji",
  "private": true,
  "version": "0.1.0",
  "description": "The right model for every step.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc && tsc -p runtime",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "runtime": "bun runtime/src/cli.ts",
    "runtime:compile": "bun build runtime/src/cli.ts --compile --outfile dist-runtime/shoji-runtime"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5"
  }
}
