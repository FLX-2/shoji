{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "ignoreCommand": "sh skip-build.sh",
  "headers": [
    {
      "source": "/(img|film)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
